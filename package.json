{
  "name": "sunchaser",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint:fix": "yarn lint --fix",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "dev": "NODE_ENV=development next dev",
    "build": "tsc --project tsconfig.json && next build",
    "start": "tsc --project tsconfig.json && next start",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "static": "npx serve@latest out",
    "clear:all": "rm -rf .next android out",
    "build-android": "npx cap add android",
    "cap-on-android": "run-cap-on-android -id com.sunchaser.app",
    "bump:android": "bash -c 'f=android/app/build.gradle; oldVC=$(grep -E \"versionCode[[:space:]]+[0-9]+\" $f | head -1 | sed -E \"s/.*versionCode[[:space:]]+([0-9]+)/\\1/\"); oldVN=$(grep -E \"versionName[[:space:]]+\\\".+\\\"\" $f | head -1 | sed -E \"s/.*versionName[[:space:]]+\\\"(.+)\\\"/\\1/\"); newVC=\"\"; newVN=\"\"; while [ $# -gt 0 ]; do case $1 in -vC) newVC=$2; shift 2;; -vN|-vname) newVN=$2; shift 2;; *) shift;; esac; done; [ -z \"$newVC\" ] && newVC=$((oldVC+1)); [ -z \"$newVN\" ] && newVN=$oldVN; sed -i \"s/versionCode[[:space:]]$oldVC/versionCode $newVC/\" $f; sed -i \"s/versionName \\\"$oldVN\\\"/versionName \\\"$newVN\\\"/\" $f; printf \"Bumped versionCode %s -> %s\\n\" \"$oldVC\" \"$newVC\"; printf \"Bumped versionName %s -> %s\\n\" \"$oldVN\" \"$newVN\"' _",
    "build-ios": "npx cap add ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/geolocation": "^7.1.4",
    "@capacitor/ios": "^7.4.2",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@fontsource/roboto": "^5.0.2",
    "@material/web": "^1.5.0",
    "@mui/icons-material": "^5.11.16",
    "@mui/material": "^5.13.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@turf/turf": "^6.5.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "@vercel/analytics": "^1.0.1",
    "@vercel/speed-insights": "^1.0.1",
    "axios": "^1.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^2.29.3",
    "dotenv": "^16.0.2",
    "embla-carousel-auto-height": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "eslint-plugin-folders": "^1.0.3",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-react": "^7.31.10",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-testing-library": "^6.2.0",
    "eslint-plugin-unicorn": "^49.0.0",
    "focus-trap-react": "^10.0.2",
    "formik": "^2.4.6",
    "geolib": "^3.3.4",
    "lodash": "^4.17.21",
    "lucide-react": "^0.542.0",
    "mapbox-gl": "^3.1.2",
    "next": "^15.4.4",
    "react": "^19.1.0",
    "react-datepicker": "^8.4.0",
    "react-day-picker": "^8.8.2",
    "react-dom": "^19.1.0",
    "react-map-gl": "^7.1.6",
    "react-swipeable": "^7.0.1",
    "swiper": "^11.0.5",
    "swr": "^2.2.4",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "vaul": "^1.1.2",
    "weather-underground-icons": "^1.0.0",
    "zustand": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@jest/globals": "^29.7.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/typography": "^0.5.16",
    "@types/lodash": "^4.17.20",
    "@types/mapbox-gl": "^2.7.19",
    "@types/node": "24.4.0",
    "@types/react": "^19.1.8",
    "@types/react-calendar": "^4.1.0",
    "@types/react-datepicker": "^4.19.3",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.54.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-tailwindcss": "^3.13.1",
    "jest": "^29.7.0",
    "lefthook": "^1.12.2",
    "postcss": "^8.5.6",
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "run-cap-on-android": "^1.0.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "ts-jest": "^29.1.2",
    "tw-animate-css": "^1.3.8",
    "webpack": "^5.89.0"
  },
  "tags": [
    "swiper"
  ],
  "engines": {
    "node": ">=20"
  }
}
